<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans 
        http://www.springframework.org/schema/beans/spring-beans.xsd">
	
	<import resource="02-spring-beans-composing.xml" />
	
	<!-- B2. Configuration Metadata   -->
    <!-- bean definitions here -->
    
	<!-- configure a bean via empty constructor  -->
	<bean id="itemgroupa" class="bkit.java18.bean.ItemGroup"></bean>    
	
	<!-- configure a bean via constructor  -->
	<bean id="itemgroupb" class="bkit.java18.bean.ItemGroup">
		<constructor-arg name="id" value="11"></constructor-arg>
		<constructor-arg name="name" value="Item Group 11"></constructor-arg>
	</bean>
	
	<!-- configure a bean via setter -->
	<bean id="itemb1" class="bkit.java18.bean.Item">
		<property name="id" value="117"></property>
		<property name="name" value="Item 117"></property>
		<property name="salesPrice" value="777"></property>
		<property name="providers">
			<list>
				<value>Fact B1</value>
				<value>Fact B2</value>
				<value>Fact B3</value>
			</list>
		</property>
		<property name="itemGroup" ref="itemgroupb">
		</property>
	</bean>
	
	<!-- spring bean scope -->
	<bean id="itemgroupc" class="bkit.java18.bean.ItemGroup" scope="singleton"></bean>
	<bean id="itemgroupd" class="bkit.java18.bean.ItemGroup" scope="prototype"></bean>
</beans>